{
  "manifest_version": 3,
  "name": "Dashboard de Erros - Overlay",
  "version": "3.2",
  "description": "Painel flutuante in-page para registro de erros.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ]
}